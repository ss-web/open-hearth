# Read-only role used by the website. It cannot read application_private.
DATABASE_URL=postgres://hearth_public:public_read_dev@localhost:5433/open_hearth

# Owner role used only by npm run db:setup.
DATABASE_ADMIN_URL=postgres://hearth:hearth_dev_only@localhost:5433/open_hearth

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_GITHUB_URL=https://github.com/open-hearth/open-hearth
